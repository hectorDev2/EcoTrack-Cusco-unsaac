datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("CITIZEN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")

  zones     UserZone[]
  routes    Route[]
  incidents Incident[]
  vehicles  Vehicle[]

  @@map("users")
}

model Zone {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")

  users              UserZone[]
  pickupPoints       PickupPoint[]
  collectionSchedules CollectionSchedule[]
  routes             Route[]
  incidents          Incident[]

  @@map("zones")
}

model UserZone {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  zoneId     String @map("zone_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id])
  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([userId, zoneId])
  @@map("user_zones")
}

model WasteType {
  id          String @id @default(cuid())
  name        String
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  collectionSchedules CollectionSchedule[]
  collections         Collection[]

  @@map("waste_types")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS - Turnos, Tipos de parada y Frecuencias del rutero de compactadores
// ═══════════════════════════════════════════════════════════════════════════

/// Turno del día en que se realiza la ruta
enum Shift {
  MANANA     // Mañana (4:00 - 12:00)
  TARDE      // Tarde (12:00 - 18:00)
  NOCHE      // Noche (18:00 - 00:00)
  DOMINICAL  // Turno dominical
}

/// Tipo de parada según el rutero oficial
enum StopType {
  NORMAL        // Parada regular
  CAMPANEO      // Campaneo (parada con aviso sonoro)
  REPECHAJE     // Repechaje (recorrido adicional de repaso)
  VIA_PUBLICA   // Recojo de RRSS de vía pública
  DOMINICAL     // Parada solo domingos
}

/// Código de frecuencia de la ruta
enum FrequencyCode {
  LMV      // Lunes, Miércoles y Viernes
  MJS      // Martes, Jueves y Sábado
  DOM      // Solo Domingo
  DOM_LUN  // Domingo y Lunes
  TODOS    // Todos los días
}

model PickupPoint {
  id        String  @id @default(cuid())
  zoneId    String  @map("zone_id")
  name      String
  address   String
  latitude  Float
  longitude Float
  status    String  @default("ACTIVE")

  // ═══════════════════════════════════════════════════════════════════════
  // CAMPOS NUEVOS - Rutero de compactadores 2024
  // ═══════════════════════════════════════════════════════════════════════
  shift         Shift?        @map("shift")         // Turno: Mañana/Tarde/Noche/Dominical
  stopType      StopType      @default(NORMAL) @map("stop_type")  // Tipo de parada
  scheduledTime String?       @map("scheduled_time") // Hora programada HH:MM
  frequencyId   String?       @map("frequency_id")  // FK a FrequencyConfig
  orderIndex    Int           @default(0) @map("order_index") // Orden de recorrido

  // ═══════════════════════════════════════════════════════════════════════
  // RELACIONES
  // ═══════════════════════════════════════════════════════════════════════
  zone          Zone              @relation(fields: [zoneId], references: [id])
  frequency     FrequencyConfig?  @relation(fields: [frequencyId], references: [id])
  routeStops    RouteStop[]

  @@index([zoneId, shift, frequencyId])
  @@index([shift, stopType])
  @@map("pickup_points")
}

/// Frecuencia de la ruta (LMV, MJS, DOM, etc) según el rutero oficial
model FrequencyConfig {
  id    String        @id @default(cuid())
  code  FrequencyCode @unique
  label String        // "Lunes, Miércoles y Viernes"
  days  String        // "MON,WED,FRI" - días en formato iCal

  pickupPoints       PickupPoint[]
  collectionSchedules CollectionSchedule[]

  @@map("frequency_configs")
}

model CollectionSchedule {
  id          String @id @default(cuid())
  zoneId      String @map("zone_id")
  wasteTypeId String @map("waste_type_id")
  dayOfWeek   String @map("day_of_week")
  startTime   String @map("start_time")
  endTime     String @map("end_time")
  status      String @default("ACTIVE")

  // Campo opcional para vincular a la frecuencia del rutero
  frequencyId String? @map("frequency_id")

  zone      Zone             @relation(fields: [zoneId], references: [id])
  wasteType WasteType        @relation(fields: [wasteTypeId], references: [id])
  frequency FrequencyConfig? @relation(fields: [frequencyId], references: [id])

  @@map("collection_schedules")
}

model Route {
  id         String  @id @default(cuid())
  zoneId     String  @map("zone_id")
  driverId   String? @map("driver_id")   // nullable: rutas plantilla sin conductor asignado
  name       String?                      // nombre descriptivo: "Zona 1 - Mañana LMV"
  shift      String?                      // MANANA | TARDE | NOCHE | DOMINICAL
  frequency  String?                      // LMV | MJS | DOM | DOM_LUN | TODOS
  status     String  @default("PENDING")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  zone      Zone       @relation(fields: [zoneId], references: [id])
  driver    User?      @relation(fields: [driverId], references: [id])
  stops     RouteStop[]
  locations RouteLocation[]
  incidents Incident[]

  @@map("routes")
}

model RouteStop {
  id            String @id @default(cuid())
  routeId       String @map("route_id")
  pickupPointId String @map("pickup_point_id")
  orderIndex    Int    @map("order_index")
  status        String @default("PENDING")

  route       Route       @relation(fields: [routeId], references: [id])
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id])
  collection  Collection?

  @@map("route_stops")
}

model Collection {
  id          String @id @default(cuid())
  routeStopId String @unique @map("route_stop_id")
  wasteTypeId String @map("waste_type_id")
  collectedAt DateTime @default(now()) @map("collected_at")
  notes       String?

  routeStop RouteStop @relation(fields: [routeStopId], references: [id])
  wasteType WasteType @relation(fields: [wasteTypeId], references: [id])

  @@map("collections")
}

model Vehicle {
  id        String  @id @default(cuid())
  plate     String  @unique
  brand     String?
  model     String?
  capacity  Float?
  driverId  String? @map("driver_id")
  status    String  @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  driver User? @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model RouteLocation {
  id        String   @id @default(cuid())
  routeId   String   @map("route_id")
  latitude  Float
  longitude Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  route Route @relation(fields: [routeId], references: [id])

  @@index([routeId, recordedAt])
  @@map("route_locations")
}

model Incident {
  id          String   @id @default(cuid())
  reportedBy  String   @map("reported_by")
  zoneId      String?  @map("zone_id")
  routeId     String?  @map("route_id")
  type        String
  description String
  status      String   @default("OPEN")
  latitude    Float?   @map("latitude")
  longitude   Float?   @map("longitude")
  address     String?  @map("address")
  createdAt   DateTime @default(now()) @map("created_at")

  reporter User  @relation(fields: [reportedBy], references: [id])
  zone     Zone? @relation(fields: [zoneId], references: [id])
  route    Route? @relation(fields: [routeId], references: [id])

  @@map("incidents")
}
