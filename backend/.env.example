# Turso (producción)
TURSO_DATABASE_URL="libsql://tu-database.turso.io"
TURSO_AUTH_TOKEN="tu-token"

# JWT
JWT_SECRET="change-this-secret"
JWT_EXPIRATION="7d"

# Sentry (opcional - dejar vacío para deshabilitar)
SENTRY_DSN=""

# Twilio WhatsApp (opcional - dejar vacío para deshabilitar el envío real;
# las alarmas se registran en el log en su lugar)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Modo Demo (activado por defecto — poner "false" para desactivarlo en producción real)
DEMO_MODE_ENABLED="true"
