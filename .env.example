# URL del backend (local o produccion)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry - DSN público (cliente/browser)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry - DSN privado (server y edge runtime)
SENTRY_DSN=

# Sentry build (source maps) - poner en .env.sentry-build-plugin (no commitear)
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=tu-org-en-sentry
SENTRY_PROJECT=eco-track-cusco
